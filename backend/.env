PORT=4000
PUBLIC_IP_ADDRESS=127.0.0.1
MAPPED_IP=false
AUTH_SECRET=jwt-default-secret

# root user credentials
ROOT_USER_USERNAME=admin
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=admin
ROOT_USER_FIRST_NAME=Admin
ROOT_USER_LAST_NAME=User

# ✅ Full Mongo URI including database name
MONGO_URI=mongodb://127.0.0.1:27017/clover

# connection details (not used for local setup)
MONGO_SRV=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTHENTICATION_DATABASE=
MONGO_HOSTNAME=
MONGO_PORT=

# mailer
MAILER_ENABLED=false
MAILER_FROM="Clover <no-reply@yourdomain.tld>"
MAILER_USERNAME=no-reply@yourdomain.tld
MAILER_PASSWORD=
MAILER_SERVICE=
MAILER_HOST=mailer_host
MAILER_PORT=587
MAILER_SECURE=true
SUPPORT_EMAIL_ADDRESS=support@example.com
